local DragonModules = ReplicatedStorage:WaitForChild("Modules", 5)
local DragonNet = DragonModules and DragonModules:WaitForChild("Net", 5)
local ShootGunEvent = DragonNet and DragonNet:WaitForChild("RE/ShootGunEvent", 5)
local Validator2 = ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Validator2", 5)

local getupval = debug.getupvalue or getupvalue
local setupval = debug.setupvalue or setupvalue
local getupvals = debug.getupvalues or getupvalues

local ShootFunction
local V_Idx = { v26 = 12, v22 = 13, v25 = 14, v21 = 15, v23 = 16, v24 = 17, v27 = 18 }

local function InitDragonGun()
    local success, result = pcall(require, ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    if success and type(result) == "table" and result.Attack then
        ShootFunction = getupval(result.Attack, 9)
    end
end

local function GetNextValidator()
    if not ShootFunction then InitDragonGun() end
    if not ShootFunction then return 0, 0 end
    
    local upvals = getupvals(ShootFunction)
    if not upvals then return 0, 0 end
    
    if upvals[V_Idx.v21] ~= 727595 then
        for i, v in pairs(upvals) do
            if v == 727595 then
                local offset = i - 15
                V_Idx.v21 = i; V_Idx.v22 = 13 + offset; V_Idx.v23 = 16 + offset
                V_Idx.v24 = 17 + offset; V_Idx.v26 = 12 + offset; V_Idx.v25 = 14 + offset
                V_Idx.v27 = 18 + offset
                break
            end
        end
    end
    
    local v1 = getupval(ShootFunction, V_Idx.v21)
    local v2 = getupval(ShootFunction, V_Idx.v22)
    local v3 = getupval(ShootFunction, V_Idx.v23)
    local v4 = getupval(ShootFunction, V_Idx.v24)
    local v5 = getupval(ShootFunction, V_Idx.v25)
    local v6 = getupval(ShootFunction, V_Idx.v26)
    local v7 = getupval(ShootFunction, V_Idx.v27)
    
    if not (v1 and v2 and v3 and v4 and v5 and v6 and v7) then return 0, 0 end
    
    local v8 = v6 * v2
    local v9 = (v5 * v2 + v6 * v1) % v3
    v9 = (v9 * v3 + v8) % v4
    v5 = math.floor(v9 / v3)
    v6 = v9 - v5 * v3
    v7 = v8
    
    setupval(ShootFunction, V_Idx.v25, v5)
    setupval(ShootFunction, V_Idx.v26, v6)
    setupval(ShootFunction, V_Idx.v27, v7)
    
    return math.floor(v9 / 67108860), v7
end

local function isAlly(targetPlayer)
    if not targetPlayer or targetPlayer == player then return true end
    if player.Team and targetPlayer.Team and player.Team == targetPlayer.Team then return true end
    
    local isInAllyList = false
    pcall(function()
        local mainGui = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("Main")
        if mainGui then
            local alliesContainer = mainGui:FindFirstChild("Allies") and mainGui.Allies:FindFirstChild("Container")
            if alliesContainer then
                local alliesList = alliesContainer:FindFirstChild("Allies")
                if alliesList then
                    local scrollingFrame = alliesList:FindFirstChild("ScrollingFrame")
                    if scrollingFrame then
                        local frame = scrollingFrame:FindFirstChild("Frame")
                        if frame and frame:FindFirstChild(targetPlayer.Name) then
                            isInAllyList = true
                        end
                    end
                end
            end
        end
    end)
    return isInAllyList
end

local function GetClosestTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local closest, dist = nil, 5000
    local myPos = root.Position
    
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, enemy in pairs(enemiesFolder:GetChildren()) do
            if enemy:IsA("Model") and enemy ~= char then
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                local r = enemy:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and r then
                    local d = (r.Position - myPos).Magnitude
                    if d <= dist then dist = d; closest = r end
                end
            end
        end
    end
    
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= char then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local r = obj:FindFirstChild("HumanoidRootPart")
            local isPlayer = Players:GetPlayerFromCharacter(obj)
            
            if hum and hum.Health > 0 and r and not isPlayer then
                local isAllyNPC = obj:GetAttribute("Ally") or obj:GetAttribute("Allied")
                if not isAllyNPC then
                    local d = (r.Position - myPos).Magnitude
                    if d <= dist then dist = d; closest = r end
                end
            end
        end
    end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and not isAlly(p) and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            local pvpDisabled = p:GetAttribute("PvpDisabled")
            
            if hum and hum.Health > 0 and r and not pvpDisabled then
                local d = (r.Position - myPos).Magnitude
                if d <= dist then dist = d; closest = r end
            end
        end
    end
    
    return closest
end

