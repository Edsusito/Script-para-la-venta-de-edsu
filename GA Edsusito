_G.DragonAttackActive = false
local isOpen = true

local function toggleActiveState()
    _G.DragonAttackActive = not _G.DragonAttackActive
    if _G.DragonAttackActive then
        statusLabel.Text = "• Dragon M1: ON [K]"
        statusLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
        stroke.Color = Color3.fromRGB(0, 255, 150)
        toggleBtn.Text = "DESACTIVAR (K)"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 160, 90)
    else
        statusLabel.Text = "• Dragon M1: OFF [K]"
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        stroke.Color = Color3.fromRGB(255, 120, 180)
        toggleBtn.Text = "ACTIVAR (K)"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
    end
end

toggleBtn.MouseButton1Click:Connect(toggleActiveState)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.N then
        isOpen = not isOpen
        mainFrame.Visible = isOpen
    end
    if input.KeyCode == Enum.KeyCode.K then
        toggleActiveState()
    end
end)

-- Bucle Estable (0.065s para evitar bloqueos del servidor)
task.spawn(function()
    InitDragonGun()
    while true do
        task.wait(0.065)
        if _G.DragonAttackActive then
            pcall(function()
                local char = player.Character
                local tool = char and char:FindFirstChildOfClass("Tool")
                if not tool or tool.ToolTip ~= "Gun" then return end
                
                local target = GetClosestTarget()
                if not target then return end
                
                local code, count = GetNextValidator()
                if code ~= 0 and Validator2 then 
                    Validator2:FireServer(code, count) 
                end
                
                tool:SetAttribute("LocalOverheat", 0)
                tool:SetAttribute("LocalTotalShots", 0)
                
                if ShootGunEvent then
                    ShootGunEvent:FireServer(target.Position, { target })
                end
            end)
        end
    end
end)

