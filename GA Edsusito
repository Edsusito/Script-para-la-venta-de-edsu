-- ============================================
-- Inicialización mejorada del Combate
-- ============================================
local ShootFunction, V_Idx
local Validator2 = ReplicatedStorage:WaitForChild("Remotes", 5):WaitForChild("Validator2", 5)
local ShootGunEvent

local function InitDragonGun()
    local success, combat = pcall(require, ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    if not success or not combat or not combat.Attack then
        warn("No se pudo cargar CombatController. Intentando método alternativo...")
        -- Intenta con el módulo Net
        local netSuccess, net = pcall(require, ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"))
        if netSuccess and net then
            local gunRemote = net:WaitForChild("RE/ShootGunEvent", 5)
            if gunRemote then
                ShootGunEvent = gunRemote
                warn("Usando ShootGunEvent directo desde Net")
                return true
            end
        end
        return false
    end

    ShootGunEvent = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/ShootGunEvent", 5)
    
    -- Obtener la función Attack del CombatController
    local attackFunc = combat.Attack
    -- Intentar varios índices de upvalue (a veces cambia)
    for idx = 8, 12 do
        local upval = debug.getupvalue(attackFunc, idx)
        if upval and type(upval) == "function" then
            -- Verificar si esta es la función que dispara
            local upvals = debug.getupvalues(upval)
            if upvals and #upvals >= 18 then
                ShootFunction = upval
                V_Idx = { v26 = 12, v22 = 13, v25 = 14, v21 = 15, v23 = 16, v24 = 17, v27 = 18 }
                warn("CombatController inicializado correctamente.")
                return true
            end
        end
    end
    warn("No se encontró la función de disparo en CombatController.")
    return false
end

local function GetNextValidator()
    if not ShootFunction then
        if not InitDragonGun() then
            return 0, 0
        end
    end
    local upvals = debug.getupvalues(ShootFunction)
    if not upvals then return 0, 0 end
    if upvals[V_Idx.v21] ~= 727595 then
        for i, v in pairs(upvals) do
            if v == 727595 then
                local offset = i - 15
                V_Idx.v21 = i; V_Idx.v22 = 13 + offset; V_Idx.v23 = 16 + offset
                V_Idx.v24 = 17 + offset; V_Idx.v26 = 12 + offset; V_Idx.v25 = 14 + offset
                V_Idx.v27 = 18 + offset
                break
            end
        end
    end
    local v1 = debug.getupvalue(ShootFunction, V_Idx.v21)
    local v2 = debug.getupvalue(ShootFunction, V_Idx.v22)
    local v3 = debug.getupvalue(ShootFunction, V_Idx.v23)
    local v4 = debug.getupvalue(ShootFunction, V_Idx.v24)
    local v5 = debug.getupvalue(ShootFunction, V_Idx.v25)
    local v6 = debug.getupvalue(ShootFunction, V_Idx.v26)
    local v7 = debug.getupvalue(ShootFunction, V_Idx.v27)
    if not (v1 and v2 and v3 and v4 and v5 and v6 and v7) then return 0, 0 end
    local v8 = v6 * v2
    local v9 = (v5 * v2 + v6 * v1) % v3
    v9 = (v9 * v3 + v8) % v4
    v5 = math.floor(v9 / v3)
    v6 = v9 - v5 * v3
    v7 = v8
    debug.setupvalue(ShootFunction, V_Idx.v25, v5)
    debug.setupvalue(ShootFunction, V_Idx.v26, v6)
    debug.setupvalue(ShootFunction, V_Idx.v27, v7)
    return math.floor(v9 / 67108860), v7
end

local function isAlly(targetPlayer)
    if not targetPlayer or targetPlayer == player then return true end
    if player.Team and targetPlayer.Team and player.Team.Name == "Marines" and targetPlayer.Team.Name == "Marines" then
        return true
    end
    pcall(function()
        local mainGui = player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("Main")
        if mainGui then
            local alliesFrame = mainGui:FindFirstChild("Allies")
            if alliesFrame then
                local container = alliesFrame:FindFirstChild("Container")
                if container then
                    local allies = container:FindFirstChild("Allies")
                    if allies then
                        local sf = allies:FindFirstChild("ScrollingFrame")
                        if sf then
                            local frame = sf:FindFirstChild("Frame")
                            if frame and frame:FindFirstChild(targetPlayer.Name) then
                                return true
                            end
                        end
                    end
                end
            end
        end
    end)
    return false
end

-- ============================================
-- Búsqueda del objetivo más cercano (amplia)
-- ============================================
local function GetClosestTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closestPart, closestDist = nil, 3000
    local myPos = root.Position

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= char then
            local targetPart = nil
            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            
            -- Prioridad 1: Humanoid con vida > 0
            if humanoid and humanoid.Health > 0 then
                targetPart = obj:FindFirstChild("HumanoidRootPart")
            end
            
            -- Prioridad 2: Aunque no tenga Humanoid, si tiene HumanoidRootPart (raro)
            if not targetPart then
                targetPart = obj:FindFirstChild("HumanoidRootPart")
            end
            
            -- Prioridad 3: Si es un modelo sin HumanoidRootPart, usar cualquier BasePart principal
            if not targetPart then
                targetPart = obj.PrimaryPart
            end
            
            if targetPart then
                local isPlayer = Players:GetPlayerFromCharacter(obj)
                local canAttack = false
                
                if isPlayer then
                    if isPlayer ~= player and not isAlly(isPlayer) and not isPlayer:GetAttribute("PvpDisabled") then
                        canAttack = true
                    end
                else
                    -- NPC, marino, boss, barco, Sea Beast...
                    canAttack = true
                end
                
                if canAttack then
                    local dist = (targetPart.Position - myPos).Magnitude
                    if dist <= closestDist then
                        closestDist = dist
                        closestPart = targetPart
                    end
                end
            end
        end
    end
    
    return closestPart
end

