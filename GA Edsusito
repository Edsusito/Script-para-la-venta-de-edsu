RunService.RenderStepped:Connect(function(dt)
    if not catContainer or not catContainer.Parent then return end
    
    danceAngle = danceAngle + dt * 3
    danceOffset = math.sin(danceAngle) * 5
    
    -- Bailar (rotación)
    catContainer.Rotation = math.sin(danceAngle * 2) * 10
    
    -- Rebote
    catContainer.Position = UDim2.new(0.5, -35, 0, 8 + danceOffset)
    
    -- Ojos animados (se agrandan y achican)
    local eyeScale = 1 + math.sin(danceAngle * 3) * 0.2
    leftPupil.Size = UDim2.new(0, 7 * eyeScale, 0, 7 * eyeScale)
    rightPupil.Size = UDim2.new(0, 7 * eyeScale, 0, 7 * eyeScale)
    
    -- Cola (simulada moviendo el contenedor)
    catFace.Rotation = math.sin(danceAngle * 1.5) * 5
end)

