local ShootGunEvent = DragonNet:WaitForChild("RE/ShootGunEvent")
local Validator2 = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Validator2")

local getupval = debug.getupvalue
local setupval = debug.setupvalue
local getupvals = debug.getupvalues

local ShootFunction
local V_Idx = { v26 = 12, v22 = 13, v25 = 14, v21 = 15, v23 = 16, v24 = 17, v27 = 18 }

function InitDragonGun()
    local success, result = pcall(require, ReplicatedStorage:WaitForChild("Controllers"):WaitForChild("CombatController"))
    if success and type(result) == "table" and result.Attack then
        ShootFunction = getupval(result.Attack, 9)
    end
end

function GetNextValidator()
    if not ShootFunction then InitDragonGun() end
    if not ShootFunction then return 0, 0 end
    local upvals = getupvals(ShootFunction)
    if not upvals then return 0, 0 end
    if upvals[V_Idx.v21] ~= 727595 then
        for i, v in pairs(upvals) do
            if v == 727595 then
                local offset = i - 15
                V_Idx.v21 = i
                V_Idx.v22 = 13 + offset
                V_Idx.v23 = 16 + offset
                V_Idx.v24 = 17 + offset
                V_Idx.v26 = 12 + offset
                V_Idx.v25 = 14 + offset
                V_Idx.v27 = 18 + offset
                break
            end
        end
    end
    local v1 = getupval(ShootFunction, V_Idx.v21)
    local v2 = getupval(ShootFunction, V_Idx.v22)
    local v3 = getupval(ShootFunction, V_Idx.v23)
    local v4 = getupval(ShootFunction, V_Idx.v24)
    local v5 = getupval(ShootFunction, V_Idx.v25)
    local v6 = getupval(ShootFunction, V_Idx.v26)
    local v7 = getupval(ShootFunction, V_Idx.v27)
    if not (v1 and v2 and v3 and v4 and v5 and v6 and v7) then return 0, 0 end
    local v8 = v6 * v2
    local v9 = (v5 * v2 + v6 * v1) % v3
    v9 = (v9 * v3 + v8) % v4
    v5 = math.floor(v9 / v3)
    v6 = v9 - v5 * v3
    v7 = v7 + 1
    setupval(ShootFunction, V_Idx.v25, v5)
    setupval(ShootFunction, V_Idx.v26, v6)
    setupval(ShootFunction, V_Idx.v27, v7)
    return math.floor(v9 / v4 * 16777215), v7
end

-- ============================================================
-- DETECCIÓN DE ALIADOS / ENEMIGOS (sistema normal sin Focus)
-- ============================================================
local function Trim(s)
    return s:match("^%s*(.-)%s*$")
end

local function GetPlayerCrew(p)
    if not p then return nil end
    local attrNames = { "Crew", "CrewName", "CrewID" }
    for _, name in ipairs(attrNames) do
        local val = p:GetAttribute(name)
        if val then return tostring(val) end
    end
    local ls = p:FindFirstChild("leaderstats")
    if ls then
        for _, child in pairs(ls:GetChildren()) do
            if string.find(string.lower(child.Name), "crew") then
                return tostring(child.Value)
            end
        end
    end
    local crewValue = p:FindFirstChild("Crew")
    if crewValue and crewValue:IsA("ValueBase") then
        return tostring(crewValue.Value)
    end
    return nil
end

local function GetPlayerAlliances(p)
    local alliances = {}
    if not p then return alliances end
    local attrNames = { "Alliances", "AllyCrews", "AlliedCrews" }
    for _, name in ipairs(attrNames) do
        local val = p:GetAttribute(name)
        if val then
            if type(val) == "table" then
                for _, a in pairs(val) do
                    alliances[tostring(a)] = true
                end
            elseif type(val) == "string" then
                for a in string.gmatch(val, "[^,]+") do
                    alliances[Trim(a)] = true
                end
            end
            break
        end
    end
    for attrName, val in pairs(p:GetAttributes()) do
        local lower = string.lower(attrName)
        if string.find(lower, "ally") or string.find(lower, "alliance") then
            if type(val) == "table" then
                for _, a in pairs(val) do
                    alliances[tostring(a)] = true
                end
            elseif type(val) == "string" then
                for a in string.gmatch(val, "[^,]+") do
                    alliances[Trim(a)] = true
                end
            end
        end
    end
    return alliances
end

local function IsAlly(p1, p2)
    if not p1 or not p2 then return false end
    if p1 == p2 then return true end
    local team1 = p1.Team
    local team2 = p2.Team
    if not team1 or not team2 then return false end
    local t1 = string.lower(team1.Name)
    local t2 = string.lower(team2.Name)

    if (t1 == "marine" or t1 == "marines") and (t2 == "marine" or t2 == "marines") then
        return true
    end

    local isPirate1 = (t1 == "pirate" or t1 == "pirates")
    local isPirate2 = (t2 == "pirate" or t2 == "pirates")
    if (t1 == "marine" or t1 == "marines") and isPirate2 then return false end
    if isPirate1 and (t2 == "marine" or t2 == "marines") then return false end

    if isPirate1 and isPirate2 then
        local crew1 = GetPlayerCrew(p1)
        local crew2 = GetPlayerCrew(p2)
        if crew1 and crew2 and crew1 == crew2 then return true end
        local alliances1 = GetPlayerAlliances(p1)
        if crew2 and alliances1[crew2] then return true end
        local alliances2 = GetPlayerAlliances(p2)
        if crew1 and alliances2[crew1] then return true end
        return false
    end

    if team1 == team2 then return true end
    return false
end

-- ============================================================
-- OBTENER OBJETIVO MÁS CERCANO
-- ============================================================
function GetClosestDragonTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    -- [[ NUEVO FOCUS ]] Si hay Focus Target, ignorar toda selección normal y atacar solo a ese jugador
    if _G.G_FocusTarget then
        local focusPlayer = _G.G_FocusTarget
        local focusChar = focusPlayer.Character
        local focusHum = focusChar and focusChar:FindFirstChildOfClass("Humanoid")
        local focusRoot = focusChar and focusChar:FindFirstChild("HumanoidRootPart")
        if focusHum and focusHum.Health > 0 and focusRoot then
            return focusRoot
        else
            return nil -- El jugador enfocado no tiene personaje vivo; no atacar a nadie más
        end
    end

    -- Comportamiento normal sin Focus
    local closest, dist = nil, math.huge
    local myPos = root.Position

    if _G.G_AttackMobs then
        local enemies = workspace:FindFirstChild("Enemies")
        if enemies then
            for _, enemy in pairs(enemies:GetChildren()) do
                local hum = enemy:FindFirstChildOfClass("Humanoid")
                local r = enemy:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and r then
                    local d = (r.Position - myPos).Magnitude
                    if d < dist then
                        dist = d
                        closest = r
                    end
                end
            end
        end
    end

    if _G.G_AttackPlayers then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and not IsAlly(player, p) then
                local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                local r = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if hum and hum.Health > 0 and r then
                    local d = (r.Position - myPos).Magnitude
                    if d < dist then
                        dist = d
                        closest = r
                    end
                end
            end
        end
    end

    return closest
end

-- Bucle Dragon M1 (delay 0.016)
