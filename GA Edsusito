-- [[ NUEVO FOCUS ]] Función para actualizar la lista dinámica
local function RefreshPlayerList()
    -- Limpiar botones anteriores
    for _, btn in pairs(playerButtons) do
        btn:Destroy()
    end
    playerButtons = {}

    -- Comprobar si el Focus actual sigue en el servidor
    if _G.G_FocusTarget then
        local stillInGame = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p == _G.G_FocusTarget then
                stillInGame = true
                break
            end
        end
        if not stillInGame then
            _G.G_FocusTarget = nil
        end
    end

    -- Crear botones para cada jugador excepto el local
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local btn = Instance.new("TextButton", playerListHolder)
            btn.Name = p.Name
            btn.Size = UDim2.new(1, -8, 0, 22)
            btn.BackgroundColor3 = COLOR_TOGGLE_OFF
            btn.Font = Enum.Font.Code
            btn.TextSize = 11
            btn.Text = p.Name
            btn.TextColor3 = COLOR_TEXT_OFF
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 2)

            -- Guardar referencia al jugador
            playerButtons[p] = btn

            -- Resaltar si ya es el Focus
            if _G.G_FocusTarget == p then
                btn.BackgroundColor3 = COLOR_TOGGLE_ON
                btn.TextColor3 = COLOR_TEXT_ON
            end

            -- Al hacer clic, establecer Focus
            btn.MouseButton1Click:Connect(function()
                _G.G_FocusTarget = p
                RefreshPlayerList()
            end)
        end
    end

    -- Actualizar etiqueta de estado
    if _G.G_FocusTarget then
        focusStatusLabel.Text = "Focus: " .. _G.G_FocusTarget.Name
        focusStatusLabel.TextColor3 = COLOR_WHITE
    else
        focusStatusLabel.Text = "Focus: None"
        focusStatusLabel.TextColor3 = COLOR_GRAY
    end
end

