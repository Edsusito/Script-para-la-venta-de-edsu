    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextColor3 = COLOR_WHITE
    lbl.Size = UDim2.new(1, -20, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 2)
    lbl.BackgroundTransparency = 1
    lbl.TextXAlignment = Enum.TextXAlignment.Left

    local minus = Instance.new("TextButton", card)
    minus.Size = UDim2.new(0, 20, 0, 20)
    minus.Position = UDim2.new(1, -80, 0, 18)
    minus.Text = "-"
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 14
    minus.BackgroundColor3 = COLOR_TOGGLE_OFF
    minus.TextColor3 = COLOR_WHITE
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local valLabel = Instance.new("TextLabel", card)
    valLabel.Size = UDim2.new(0, 40, 0, 20)
    valLabel.Position = UDim2.new(1, -58, 0, 18)
    valLabel.Text = tostring(default)
    valLabel.Font = Enum.Font.GothamBold
    valLabel.TextSize = 12
    valLabel.TextColor3 = COLOR_WHITE
    valLabel.BackgroundTransparency = 1

    local plus = Instance.new("TextButton", card)
    plus.Size = UDim2.new(0, 20, 0, 20)
    plus.Position = UDim2.new(1, -22, 0, 18)
    plus.Text = "+"
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 14
    plus.BackgroundColor3 = COLOR_TOGGLE_OFF
    plus.TextColor3 = COLOR_WHITE
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

    local current = default
    local function updateVal(v)
        current = math.clamp(v, min, max)
        valLabel.Text = tostring(current)
        callback(current)
    end

    minus.MouseButton1Click:Connect(function() updateVal(current - 1) end)
    plus.MouseButton1Click:Connect(function() updateVal(current + 1) end)
end

