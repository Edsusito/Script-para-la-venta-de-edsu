local playerButtons = {}

local function RefreshPlayerList()
    for _, btn in pairs(playerButtons) do
        btn:Destroy()
    end
    playerButtons = {}

    if _G.G_FocusTarget then
        local stillInGame = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p == _G.G_FocusTarget then
                stillInGame = true
                break
            end
        end
        if not stillInGame then
            _G.G_FocusTarget = nil
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            local btn = Instance.new("TextButton", playerListHolder)
            btn.Name = p.Name
            btn.Size = UDim2.new(1, -10, 0, 24)
            btn.BackgroundColor3 = COLOR_TOGGLE_OFF
            btn.BackgroundTransparency = 0.25
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            btn.Text = p.Name
            btn.TextColor3 = COLOR_TEXT_OFF
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

            playerButtons[p] = btn

            if _G.G_FocusTarget == p then
                btn.BackgroundColor3 = COLOR_TOGGLE_ON
                btn.BackgroundTransparency = 0
                btn.TextColor3 = COLOR_TEXT_ON
            end

            btn.MouseButton1Click:Connect(function()
                _G.G_FocusTarget = p
                RefreshPlayerList()
            end)
        end
    end

    if _G.G_FocusTarget then
        focusStatusLabel.Text = "Focus: " .. _G.G_FocusTarget.Name
        focusStatusLabel.TextColor3 = COLOR_TEXT
    else
        focusStatusLabel.Text = "Focus: None"
        focusStatusLabel.TextColor3 = COLOR_TEXT_DIM
    end
end

