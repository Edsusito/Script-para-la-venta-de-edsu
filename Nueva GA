-- DETECCIÓN DE ALIADOS
-- ============================================================
local function Trim(s)
    return s:match("^%s*(.-)%s*$")
end

local function GetPlayerCrew(p)
    if not p then return nil end
    local attrNames = { "Crew", "CrewName", "CrewID" }
    for _, name in ipairs(attrNames) do
        local val = p:GetAttribute(name)
        if val then return tostring(val) end
    end
    local ls = p:FindFirstChild("leaderstats")
    if ls then
        for _, child in pairs(ls:GetChildren()) do
            if string.find(string.lower(child.Name), "crew") then
                return tostring(child.Value)
            end
        end
    end
    local crewValue = p:FindFirstChild("Crew")
    if crewValue and crewValue:IsA("ValueBase") then
        return tostring(crewValue.Value)
    end
    return nil
end

local function GetPlayerAlliances(p)
    local alliances = {}
    if not p then return alliances end
    local attrNames = { "Alliances", "AllyCrews", "AlliedCrews" }
    for _, name in ipairs(attrNames) do
        local val = p:GetAttribute(name)
        if val then
            if type(val) == "table" then
                for _, a in pairs(val) do
                    alliances[tostring(a)] = true
                end
            elseif type(val) == "string" then
                for a in string.gmatch(val, "[^,]+") do
                    alliances[Trim(a)] = true
                end
            end
            break
        end
    end
    for attrName, val in pairs(p:GetAttributes()) do
        local lower = string.lower(attrName)
        if string.find(lower, "ally") or string.find(lower, "alliance") then
            if type(val) == "table" then
                for _, a in pairs(val) do
                    alliances[tostring(a)] = true
                end
            elseif type(val) == "string" then
                for a in string.gmatch(val, "[^,]+") do
                    alliances[Trim(a)] = true
                end
            end
        end
    end
    return alliances
end

local function IsAlly(p1, p2)
    if not p1 or not p2 then return false end
    if p1 == p2 then return true end
    local team1 = p1.Team
    local team2 = p2.Team
    if not team1 or not team2 then return false end
    local t1 = string.lower(team1.Name)
    local t2 = string.lower(team2.Name)

    if (t1 == "marine" or t1 == "marines") and (t2 == "marine" or t2 == "marines") then
        return true
    end

    local isPirate1 = (t1 == "pirate" or t1 == "pirates")
    local isPirate2 = (t2 == "pirate" or t2 == "pirates")
    if (t1 == "marine" or t1 == "marines") and isPirate2 then return false end
    if isPirate1 and (t2 == "marine" or t2 == "marines") then return false end

    if isPirate1 and isPirate2 then
        local crew1 = GetPlayerCrew(p1)
        local crew2 = GetPlayerCrew(p2)
        if crew1 and crew2 and crew1 == crew2 then return true end
        local alliances1 = GetPlayerAlliances(p1)
        if crew2 and alliances1[crew2] then return true end
        local alliances2 = GetPlayerAlliances(p2)
        if crew1 and alliances2[crew1] then return true end
        return false
    end

    if team1 == team2 then return true end
    return false
end

-- ============================================================
-- OBTENER OBJETIVO MÁS CERCANO (MEJORADO)
-- ============================================================
function GetClosestDragonTarget()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    -- 1. FOCUS
    if _G.G_FocusTarget then
        local focusPlayer = _G.G_FocusTarget
        local focusChar = focusPlayer.Character
        local focusHum = focusChar and focusChar:FindFirstChildOfClass("Humanoid")
        local focusRoot = focusChar and focusChar:FindFirstChild("HumanoidRootPart")

        if focusHum and focusHum.Health > 0 and focusRoot then
            local d = (focusRoot.Position - root.Position).Magnitude
            if d <= MAX_DISTANCE then
                return focusRoot
            end
        end
        return nil
    end

    local closest, dist = nil, math.huge
    local myPos = root.Position

    -- Función para verificar si está vivo
    local function IsAlive(model)
        if not model or not model.Parent then return false end
        local hum = model:FindFirstChildOfClass("Humanoid")
        if hum then
            return hum.Health > 0
        end
        local healthValue = model:FindFirstChild("Health")
        if healthValue and (healthValue:IsA("NumberValue") or healthValue:IsA("IntValue")) then
            return healthValue.Value > 0
        end
        return true
    end

    -- 2. LEVIATHAN
    if _G.G_AttackLeviathan then
        local seaBeasts = workspace:FindFirstChild("SeaBeasts")
        if seaBeasts then
            local levi = seaBeasts:FindFirstChild("Leviathan")
            if levi and IsAlive(levi) then
                local r = levi:FindFirstChild("HumanoidRootPart")
                    or levi:FindFirstChild("Hitbox13")
                    or levi.PrimaryPart
                    or levi:FindFirstChildWhichIsA("BasePart")

                if r then
                    local d = (r.Position - myPos).Magnitude
                    if d <= MAX_DISTANCE then
                        return r
                    end
                end
            end
        end
    end

    -- 3. BARCOS (detección robusta)
    if _G.G_AttackShips then
        local enemies = workspace:FindFirstChild("Enemies")
        if enemies then
            for _, obj in pairs(enemies:GetChildren()) do
                local name = obj.Name

                local isShip = name == "PirateBrigade"
                    or name == "PirateGrandBrigade"
                    or name == "MarineBrigade"
                    or name == "MarineGrandBrigade"
                    or name == "FishBoat"
                    or name:find("Brigade")
                    or name:find("Boat")
                    or name:find("Ship")

                if isShip and IsAlive(obj) then
                    local r = obj.PrimaryPart
                        or obj:FindFirstChild("HumanoidRootPart")
                        or obj:FindFirstChildWhichIsA("BasePart")

                    if r then
                        local d = (r.Position - myPos).Magnitude
                        if d < dist and d <= MAX_DISTANCE then
                            dist = d
                            closest = r
                        end
                    end
                end
            end
        end
    end

    -- 4. SEA EVENTS
    if _G.G_AttackSeaEvents then
        pcall(function()
            local seaBeasts = workspace:FindFirstChild("SeaBeasts")
            if seaBeasts then
                for _, beast in pairs(seaBeasts:GetChildren()) do
                    if beast.Name ~= "Leviathan" and IsAlive(beast) then
                        local r = beast:FindFirstChild("HumanoidRootPart")
                            or beast.PrimaryPart
                            or beast:FindFirstChild("Head")
                            or beast:FindFirstChildWhichIsA("BasePart")

                        if r then
                            local d = (r.Position - myPos).Magnitude
                            if d < dist and d <= MAX_DISTANCE then
                                dist = d
                                closest = r
                            end
                        end
                    end
                end
            end

            local enemies = workspace:FindFirstChild("Enemies")
            if enemies then
                for _, enemy in pairs(enemies:GetChildren()) do
                    if enemy.Name == "Terrorshark" and IsAlive(enemy) then
                        local r = enemy:FindFirstChild("HumanoidRootPart")
                        if r then
                            local d = (r.Position - myPos).Magnitude
                            if d < dist and d <= MAX_DISTANCE then
                                dist = d
                                closest = r
                            end
                        end
                    end
                end
            end
        end)
    end

    -- 5. MOBS
    if _G.G_AttackMobs then
        local enemies = workspace:FindFirstChild("Enemies")
        if enemies then
            for _, enemy in pairs(enemies:GetChildren()) do
                local name = enemy.Name
                local isSpecial = name == "Terrorshark"
                    or name:find("Brigade")
                    or name:find("Boat")
                    or name:find("Ship")

                if not isSpecial and IsAlive(enemy) then
                    local r = enemy:FindFirstChild("HumanoidRootPart")
                    if r then
                        local d = (r.Position - myPos).Magnitude
                        if d < dist and d <= MAX_DISTANCE then
                            dist = d
                            closest = r
                        end
                    end
                end
            end
        end
    end

    -- 6. PLAYERS
    if _G.G_AttackPlayers then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and not IsAlly(player, p) then
                local pChar = p.Character
                local hum = pChar and pChar:FindFirstChildOfClass("Humanoid")
                local r = pChar and pChar:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 and r then
                    local d = (r.Position - myPos).Magnitude
                    if d < dist and d <= MAX_DISTANCE then
                        dist = d
                        closest = r
                    end
                end
            end
        end
    end

    return closest
end

