local function stopFlying()
    isFlying = false
    isAuto = false
    isDancing = false
    
    ToggleBtn.Text = "VUELO MANUAL: OFF"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
    AutoBtn.Text = "AUTO AVANCE: OFF"
    AutoBtn.BackgroundColor3 = Color3.fromRGB(0, 10, 30)
    DanceBtn.Text = "🐄 MODO BAILE: OFF"
    DanceBtn.BackgroundColor3 = Color3.fromRGB(20, 0, 30)
    
    if renderConnection then renderConnection:Disconnect() renderConnection = nil end
    if lv then lv:Destroy() lv = nil end
    if ao then ao:Destroy() ao = nil end
    if attachment then attachment:Destroy() attachment = nil end
end

